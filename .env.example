# No environment variables are required for the static prototype.
# Server-side AI configuration will be added with the API milestone.

# AI Provider Configuration
# Set AI_PROVIDER to 'gemini' to use Gemini, or 'mock' for development
AI_PROVIDER=mock

# Gemini API Configuration (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model selection (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Frontend API URL (for production deployments)
# VITE_API_BASE_URL=http://localhost:8787

# ============================================
# Supabase Configuration (for authentication and cloud projects)
# These variables are required for Phase 7+ features
# ============================================

# Supabase project URL (from your Supabase project settings)
# Example: https://your-project.supabase.co
SUPABASE_URL=

# Supabase anonymous key (from your Supabase project API settings)
# This key is safe to expose to the browser
SUPABASE_ANON_KEY=

# Supabase service role key (SERVER-SIDE ONLY - never expose to browser)
# This key has elevated privileges and should only be used in backend code
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Supabase project region (for multi-region setups)
# SUPABASE_REGION=us-east-1
