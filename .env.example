# No environment variables are required for the static prototype.
# Server-side AI configuration will be added with the API milestone.

# AI Provider Configuration
# Set AI_PROVIDER to 'gemini' to use Gemini, or 'mock' for development
AI_PROVIDER=mock

# Gemini API Configuration (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model selection (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Frontend API URL (for production deployments)
# VITE_API_BASE_URL=http://localhost:8787
